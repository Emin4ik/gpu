{
  "version": "0.1",
  "description": "Staged evidence corpus for blind replay. Later stages contain evidence that must not be visible when the planner chooses an earlier next test.",
  "cases": [
    {
      "id": "ARGUS-02",
      "source": "https://arxiv.org/abs/2606.20374",
      "symptom": "Stable distributed-training throughput is materially below baseline and communication regression is localized to a rank group.",
      "expected_final_hypothesis": "pcie_path_degradation",
      "stages": [
        {
          "name": "T1-cheap-evidence",
          "add_observations": [
            {"key": "communication_regression_localized", "value": true, "source": "workload-trace"},
            {"key": "affected_ranks_share_pcie_path", "value": true, "source": "topology"},
            {"key": "affected_ranks_share_hca", "value": true, "source": "topology"},
            {"key": "gpu_health_clean", "value": true, "source": "dcgm"}
          ],
          "expected_next_test": "collect_pcie_link_state",
          "expected_statuses": {"pcie_path_degradation": "supported"}
        },
        {
          "name": "T2-pcie-state",
          "add_observations": [
            {"key": "pcie_width", "value": 8, "source": "lspci"},
            {"key": "pcie_expected_width", "value": 16, "source": "baseline"},
            {"key": "fabric_counters_clean", "value": true, "source": "fabric-counters"}
          ],
          "expected_next_test": "targeted_nccl_validation",
          "expected_statuses": {"pcie_path_degradation": "probable"}
        },
        {
          "name": "T3-confirmation",
          "add_observations": [
            {"key": "targeted_nccl_validation_failed", "value": true, "source": "nccl-tests"}
          ],
          "allow_confirmed": true,
          "expected_statuses": {"pcie_path_degradation": "confirmed"}
        }
      ]
    },
    {
      "id": "NVIDIA-NET-01",
      "source": "https://developer.nvidia.com/blog/next-generation-ai-factory-telemetry-with-nvidia-spectrum-x-ethernet/",
      "symptom": "Long-running workload has irregular bandwidth drops localized to one network path.",
      "expected_final_hypothesis": "fabric_link_degradation",
      "stages": [
        {
          "name": "T1-cheap-evidence",
          "add_observations": [
            {"key": "communication_regression_localized", "value": true, "source": "workload"},
            {"key": "affected_ranks_share_hca", "value": true, "source": "identity-map"},
            {"key": "gpu_health_clean", "value": true, "source": "dcgm"},
            {"key": "pcie_width", "value": 16, "source": "lspci"},
            {"key": "pcie_expected_width", "value": 16, "source": "baseline"}
          ],
          "expected_next_test": "collect_fabric_counters",
          "expected_statuses": {"fabric_link_degradation": "supported"}
        },
        {
          "name": "T2-fabric-counters",
          "add_observations": [
            {"key": "fabric_error_counters_rising", "value": true, "source": "bluefield-or-hca"}
          ],
          "expected_next_test": "inspect_fabric_port",
          "expected_statuses": {"fabric_link_degradation": "probable"}
        },
        {
          "name": "T3-confirmation",
          "add_observations": [
            {"key": "faulty_fabric_port_confirmed", "value": true, "source": "switch-telemetry"}
          ],
          "allow_confirmed": true,
          "expected_statuses": {"fabric_link_degradation": "confirmed"}
        }
      ]
    },
    {
      "id": "SYSOM-01",
      "source": "https://arxiv.org/abs/2603.29235",
      "symptom": "One training rank computes slower while GPU utilization remains high.",
      "expected_final_hypothesis": "gpu_thermal_frequency_degradation",
      "stages": [
        {
          "name": "T1-peer-skew",
          "add_observations": [
            {"key": "compute_straggler_localized", "value": true, "source": "workload-trace"},
            {"key": "gpu_utilization_high", "value": true, "source": "dcgm"},
            {"key": "gpu_health_clean", "value": true, "source": "dcgm"}
          ],
          "expected_next_test": "collect_gpu_clock_thermal_state",
          "expected_statuses": {"gpu_thermal_frequency_degradation": "supported"}
        },
        {
          "name": "T2-clock-thermal",
          "add_observations": [
            {"key": "gpu_clock_below_peer", "value": true, "source": "nvidia-smi"},
            {"key": "thermal_throttle_reason", "value": true, "source": "nvidia-smi"}
          ],
          "expected_next_test": "validate_thermal_recovery",
          "expected_statuses": {"gpu_thermal_frequency_degradation": "probable"}
        },
        {
          "name": "T3-confirmation",
          "add_observations": [
            {"key": "thermal_fix_restored_performance", "value": true, "source": "repair-validation"}
          ],
          "allow_confirmed": true,
          "expected_statuses": {"gpu_thermal_frequency_degradation": "confirmed"}
        }
      ]
    },
    {
      "id": "SYSOM-02",
      "source": "https://arxiv.org/abs/2603.29235",
      "symptom": "Collective waits grow while GPU kernel durations match healthy peers.",
      "expected_final_hypothesis": "host_cpu_irq_interference",
