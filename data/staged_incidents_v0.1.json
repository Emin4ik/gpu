          "expected_next_test": "collect_irq_affinity",
          "expected_statuses": {"host_cpu_irq_interference": "supported"}
        },
        {
          "name": "T2-irq-affinity",
          "add_observations": [
            {"key": "irq_shares_nccl_cpu", "value": true, "source": "proc-interrupts"}
